# SorbetDay for Ghostty, part of cosmic-sorbetday-theme (MIT).
# Colours follow the COSMIC Terminal scheme (cosmic-term/).
#
# Install: ./ghostty/install.sh puts this in ~/.config/ghostty/themes/, then in
# ~/.config/ghostty/config:
#   theme = SorbetDay
# or, with the Sorbet half installed too, following COSMIC's Dark / Light toggle:
#   theme = dark:Sorbet,light:SorbetDay

