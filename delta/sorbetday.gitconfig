# SorbetDay for delta (the git diff pager), part of cosmic-sorbetday-theme (MIT).
# Removed lines in the error colour, added lines in the success colour, both
# on the editor's container; changed words on a solid error / success block
# with the editor background as text (the same as DiffAdd / DiffDelete /
# DiffText in Neovim). Code inside the diff uses the bat SorbetDay theme, so run
# ./bat/install.sh first.
#
# Install: ./delta/install.sh puts this in ~/.config/delta/, then add to
# ~/.gitconfig (the installer prints this, it never edits ~/.gitconfig):
#   [include]
#       path = ~/.config/delta/sorbetday.gitconfig
# and, if delta is not your pager yet:
#   [core]
#       pager = delta
#   [interactive]
#       diffFilter = delta --color-only

[delta]
    features = sorbetday

[delta "sorbetday"]
    light = true
    syntax-theme = SorbetDay
    navigate = true
    line-numbers = true

    file-style = bold "#1C685C"
    file-decoration-style = "#D4CAD4" ul
    hunk-header-style = file line-number syntax
    hunk-header-decoration-style = "#D4CAD4" box
    hunk-header-file-style = "#684488"
    hunk-header-line-number-style = "#68602C"

    minus-style = "#963653" "#F4EEF4"
    minus-emph-style = bold "#E9E2E9" "#963653"
    minus-non-emph-style = "#963653" "#F4EEF4"
    plus-style = "#2E6B29" "#F4EEF4"
    plus-emph-style = bold "#E9E2E9" "#2E6B29"
    plus-non-emph-style = "#2E6B29" "#F4EEF4"
    zero-style = syntax
    whitespace-error-style = "#E9E2E9" "#895125"

    line-numbers-left-style = "#D4CAD4"
    line-numbers-right-style = "#D4CAD4"
    line-numbers-minus-style = "#963653"
    line-numbers-plus-style = "#2E6B29"
    line-numbers-zero-style = "#959295"

    commit-style = bold "#68602C"
    commit-decoration-style = "#D4CAD4" box
    blame-palette = "#E9E2E9 #F4EEF4 #E0D6E0"
    blame-code-style = syntax
    merge-conflict-begin-symbol = ▼
    merge-conflict-end-symbol = ▲
    merge-conflict-ours-diff-header-style = bold "#2E6B29"
    merge-conflict-theirs-diff-header-style = bold "#895125"
